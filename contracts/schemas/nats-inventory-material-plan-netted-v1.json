{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "nats-envelope-v1.json",
  "required": ["tenantId", "organizationId", "actor", "causationId"],
  "properties": {
    "messageType": {"pattern": "^v1\\.business\\.[0-9a-f-]{36}\\.inventory\\.event\\.material-plan\\.netted\\.v1$"},
    "protocolVersion": {"const": "1.0.0"},
    "schemaVersion": {"const": "1.0.0"},
    "sourceService": {"const": "erp4us.inventory"},
    "actor": {"properties": {"id": {"$ref": "nats-envelope-v1.json#/$defs/id"}}},
    "payload": {
      "type": "object",
      "required": ["planId", "orderId", "lineId", "bom", "buyRows"],
      "properties": {
        "planId": {"$ref": "nats-envelope-v1.json#/$defs/id"},
        "orderId": {"$ref": "nats-envelope-v1.json#/$defs/id"},
        "lineId": {"$ref": "nats-envelope-v1.json#/$defs/id"},
        "bom": {
          "type": "object",
          "required": ["sku", "revision"],
          "properties": {"sku": {"$ref": "#/$defs/sku"}, "revision": {"$ref": "#/$defs/revision"}}
        },
        "buyRows": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["sku", "revision", "unit", "pieces"],
            "properties": {
              "sku": {"$ref": "#/$defs/sku"},
              "revision": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/revision"}]},
              "unit": {"const": "EA"},
              "pieces": {"type": "string", "pattern": "^(?:[1-9][0-9]{0,5}|1000000)(?![\\s\\S])"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sku": {"type": "string", "minLength": 1, "maxLength": 64, "not": {"pattern": "[^A-Z0-9-]"}},
    "revision": {"type": "string", "minLength": 1, "maxLength": 32, "not": {"pattern": "[^A-Za-z0-9._-]"}}
  }
}
