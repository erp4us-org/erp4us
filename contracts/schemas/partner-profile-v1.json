{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional partner profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contact", "address", "delivery_address", "payment_days", "currency", "language"],
  "properties": {
    "contact": {"$ref": "#/$defs/label"},
    "address": {"$ref": "#/$defs/address"},
    "delivery_address": {"$ref": "#/$defs/address"},
    "payment_days": {"type": "integer", "minimum": 0, "maximum": 365},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}(?![\\s\\S])"},
    "language": {"type": "string", "pattern": "^[a-z]{2}(?![\\s\\S])"}
  },
  "$defs": {
    "label": {
      "type": "string", "minLength": 1, "maxLength": 120,
      "pattern": "\\S", "not": {"pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"}
    },
    "address": {
      "type": "object", "additionalProperties": false,
      "required": ["street", "postal_code", "city", "country"],
      "properties": {
        "street": {"$ref": "#/$defs/label"},
        "postal_code": {"$ref": "#/$defs/label"},
        "city": {"$ref": "#/$defs/label"},
        "country": {"type": "string", "pattern": "^[A-Z]{2}(?![\\s\\S])"}
      }
    }
  }
}
