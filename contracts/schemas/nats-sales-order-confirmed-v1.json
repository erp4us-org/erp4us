{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "nats-envelope-v1.json",
  "required": ["tenantId", "organizationId", "actor"],
  "properties": {
    "messageType": {"pattern": "^v1\\.business\\.[0-9a-f-]{36}\\.sales\\.event\\.order\\.confirmed\\.v1$"},
    "protocolVersion": {"const": "1.0.0"},
    "schemaVersion": {"const": "1.0.0"},
    "sourceService": {"const": "erp4us.sales"},
    "payload": {
      "type": "object",
      "required": ["orderId", "revision", "lineId", "sku", "productRevision", "unit", "pieces"],
      "properties": {
        "orderId": {"$ref": "nats-envelope-v1.json#/$defs/id"},
        "revision": {"const": 2},
        "lineId": {"$ref": "nats-envelope-v1.json#/$defs/id"},
        "sku": {"type": "string", "minLength": 1, "maxLength": 64, "not": {"pattern": "[^A-Z0-9-]"}},
        "productRevision": {"type": "string", "minLength": 1, "maxLength": 32, "not": {"pattern": "[^A-Za-z0-9._-]"}},
        "unit": {"const": "EA"},
        "pieces": {"type": "string", "pattern": "^(?:[1-9][0-9]{0,2}|1000)(?![\\s\\S])"}
      }
    }
  }
}
